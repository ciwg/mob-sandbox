#!/usr/bin/env bash
#
# List GitHub Codespaces across an entire enterprise (all orgs).
#
# This script is intended for GitHub Enterprise Cloud on github.com.
#
# Requirements:
# - gh CLI installed: https://cli.github.com/
# - Authenticated as a user who can:
#   - read the enterprise's org list (typically enterprise owner)
#   - list codespaces for each org (typically org admin/owner)
#
# Output:
# - Default (interactive): aligned columns for humans (spaces).
# - Non-interactive (piped): TSV for machines.
# - Override with --table / --tsv.
#
# Columns:
#   org  codespace  owner  repo  state  machine  createdAt  lastUsedAt
#
# Examples:
#   ./gh-codespace-list-all my-enterprise-slug
#   ENTERPRISE=my-enterprise-slug ./gh-codespace-list-all
#   ./gh-codespace-list-all --org my-org
#   ./gh-codespace-list-all --tsv my-enterprise-slug > codespaces.tsv
#
# Notes:
# - If you are not an org admin for a given org, listing that org's codespaces may
#   fail. The script will warn and continue with other orgs.
# - For GitHub Enterprise Server (GHES), set GH_HOST or pass --hostname, but note
#   that enterprise APIs and Codespaces availability differ from github.com.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  gh-codespace-list-all [--hostname HOST] <enterprise-slug>
  gh-codespace-list-all [--hostname HOST] --org <org>

Options:
  --hostname HOST   GitHub hostname (default: $GH_HOST or github.com)
  --org ORG         List codespaces for a single org only
  --table           Aligned columns (default when stdout is a TTY)
  --tsv             Tab-separated output (default when stdout is not a TTY)
  --header          Print a header row
  -h, --help        Show help

Output:
  Rows (either aligned text or TSV):
    org  codespace  owner  repo  state  machine  createdAt  lastUsedAt
USAGE
}

die() {
  echo "ERROR: $*" >&2
  exit 2
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

hostname="${GH_HOST:-github.com}"
enterprise="${ENTERPRISE:-}"
single_org=""
format="tsv"
header="0"

if [[ -t 1 ]]; then
  format="table"
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --hostname)
      [[ $# -ge 2 ]] || die "--hostname requires an argument"
      hostname="$2"
      shift 2
      ;;
    --org)
      [[ $# -ge 2 ]] || die "--org requires an argument"
      single_org="$2"
      shift 2
      ;;
    --table)
      format="table"
      shift
      ;;
    --tsv)
      format="tsv"
      shift
      ;;
    --header)
      header="1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      if [[ -n "$enterprise" ]]; then
        die "unexpected argument: $1 (enterprise already set to '$enterprise')"
      fi
      enterprise="$1"
      shift
      ;;
  esac
done

have_cmd gh || die "gh not found in PATH"

# Ensure we have credentials for the target host.
if ! GH_HOST="$hostname" gh auth status --hostname "$hostname" >/dev/null 2>&1; then
  die "not authenticated to '$hostname' (run: gh auth login --hostname '$hostname')"
fi

# Collect rows to a temp file so we can optionally format as an aligned table.
rows_file="$(mktemp "${TMPDIR:-/tmp}/gh-codespace-list-all.rows.XXXXXX")"
err_file="$(mktemp "${TMPDIR:-/tmp}/gh-codespace-list-all.err.XXXXXX")"
trap 'rm -f "$rows_file" "$err_file" >/dev/null 2>&1 || true' EXIT

if [[ "$header" == "1" ]]; then
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "org" "codespace" "owner" "repo" "state" "machine" "createdAt" "lastUsedAt" \
    >"$rows_file"
fi

format_rows() {
  local file="$1"

  case "$format" in
    tsv)
      cat "$file"
      ;;
    table)
      awk -F '\t' '
        {
          rows[NR] = $0
          for (i = 1; i <= NF; i++) {
            if (length($i) > w[i]) w[i] = length($i)
          }
          if (NF > maxNF) maxNF = NF
        }
        END {
          if (NR == 0) exit 0
          for (r = 1; r <= NR; r++) {
            n = split(rows[r], f, "\t")
            for (i = 1; i <= maxNF; i++) {
              val = (i <= n ? f[i] : "")
              printf "%-*s", w[i], val
              if (i < maxNF) printf "  "
            }
            printf "\n"
          }
        }' "$file"
      ;;
    *)
      echo "ERROR: unknown format: $format" >&2
      return 2
      ;;
  esac
}

# Repo full names for codespaces owned by the authenticated user (one per line).
# Used only to provide a hint when org listings are empty.
self_codespace_repos=$(
  GH_HOST="$hostname" gh codespace list \
    --json repository \
    --jq '.[] | (
      .repository
      | if type == "object" then (.fullName // empty)
        elif type == "string" then .
        else empty
        end
    )' \
    2>/dev/null || true
)

list_org_codespaces_tsv() {
  local org="$1"
  local out=""
  local self_count="0"

  # `gh codespace list --org` requires org admin/owner privileges.
  # We warn-and-continue to avoid failing the whole enterprise scan.
  if ! out=$(
    GH_HOST="$hostname" gh codespace list --org "$org" \
      --json name,owner,repository,state,machineName,createdAt,lastUsedAt \
      --jq '.[] | [
        .name,
        (
          .owner
          | if type == "object" then (.login // "")
            elif type == "string" then .
            else ""
            end
        ),
        (
          .repository
          | if type == "object" then (.fullName // "")
            elif type == "string" then .
            else ""
            end
        ),
        (.state // ""),
        (.machineName // ""),
        (.createdAt // ""),
        (.lastUsedAt // "")
      ] | map(tostring) | join("\t")' \
      2>"$err_file" \
      | awk -v org="$org" 'NF { print org "\t" $0 }'
  ); then
    # Emit the error and continue.
    if [[ -s "$err_file" ]]; then
      echo "WARN: org '$org': $(head -n 1 "$err_file")" >&2
    else
      echo "WARN: org '$org': unable to list codespaces" >&2
    fi
    return 0
  fi

  if [[ -n "$out" ]]; then
    printf '%s\n' "$out"
    return 0
  fi

  # No output means there are no codespaces visible via org listing for this org.
  if [[ -n "${self_codespace_repos:-}" ]]; then
    self_count=$(
      printf '%s\n' "$self_codespace_repos" | awk -v org="$org" -F/ '$1==org { c++ } END { print c+0 }'
    )
  fi
  if [[ "$self_count" != "0" ]]; then
    echo "INFO: org '$org': no codespaces found (you have $self_count personal codespaces in $org/* repos)" >&2
  else
    echo "INFO: org '$org': no codespaces found" >&2
  fi
}

if [[ -n "$single_org" ]]; then
  list_org_codespaces_tsv "$single_org" >>"$rows_file"
  format_rows "$rows_file"
  exit 0
fi

[[ -n "$enterprise" ]] || die "missing enterprise slug (or pass --org)"

orgs=$(
  GH_HOST="$hostname" gh api graphql --hostname "$hostname" --paginate \
    -F slug="$enterprise" \
    -f query='
      query($slug:String!, $endCursor:String) {
        enterprise(slug:$slug) {
          organizations(first:100, after:$endCursor) {
            nodes { login }
            pageInfo { hasNextPage endCursor }
          }
        }
      }' \
    --jq '.data.enterprise.organizations.nodes[]?.login'
)

if [[ -z "$orgs" ]]; then
  # Provide a more actionable error than "cannot iterate over: null".
  if GH_HOST="$hostname" gh api --hostname "$hostname" "orgs/$enterprise" >/dev/null 2>&1; then
    die "'$enterprise' looks like an org login, not an enterprise slug (try: $0 --org $enterprise)"
  fi

  enterprise_slug=$(
    GH_HOST="$hostname" gh api graphql --hostname "$hostname" \
      -F slug="$enterprise" \
      -f query='query($slug:String!){ enterprise(slug:$slug){ slug } }' \
      --jq '.data.enterprise.slug // empty'
  )
  if [[ -z "$enterprise_slug" ]]; then
    enterprise_err=$(
      GH_HOST="$hostname" gh api graphql --hostname "$hostname" \
        -F slug="$enterprise" \
        -f query='query($slug:String!){ enterprise(slug:$slug){ slug } }' \
        --jq '.errors[0].message // empty'
    )
    if [[ -n "$enterprise_err" ]]; then
      die "cannot access enterprise '$enterprise' on '$hostname': $enterprise_err"
    fi
  fi

  die "no orgs found for enterprise '$enterprise' on '$hostname' (slug wrong, no orgs, or insufficient permissions)"
fi

while IFS= read -r org; do
  [[ -n "$org" ]] || continue
  echo "INFO: listing codespaces for org '$org'..." >&2
  list_org_codespaces_tsv "$org" >>"$rows_file"
done <<<"$orgs"

format_rows "$rows_file"

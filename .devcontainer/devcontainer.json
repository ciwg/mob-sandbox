{
  // Dev container config for GitHub Codespaces / VS Code Dev Containers.
  //
  // This repo is intentionally a sandbox, so we keep the container setup
  // lightweight and general-purpose. Extend `postCreateCommand.sh` as new
  // exercises/tools get added.
  "name": "mob-sandbox",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": ".devcontainer/postCreateCommand.sh",
  "remoteEnv": {
    // Ensure tools installed into ~/.local/bin are available in terminals.
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.local/bin"
  },
  "secrets": {
    "OPENAI_API_KEY": {
      "description": "Personal OpenAI API key used by local experiments and tooling.",
      "documentationUrl": "https://platform.openai.com/api-keys"
    }
  }
}
